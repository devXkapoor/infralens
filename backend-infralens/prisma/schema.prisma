generator client {
  provider = "prisma-client"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

enum ServiceType {
  API
  WORKER
  DATABASE
  CACHE
  LOAD_BALANCER
  QUEUE
  STORAGE
  EXTERNAL
}

enum ServiceStatus {
  HEALTHY
  DEGRADED
  DOWN
}

model Project {
  id          String       @id @default(cuid())
  name        String
  description String?

  services    Service[]
  connections Connection[]

  createdAt   DateTime     @default(now())
  updatedAt   DateTime     @updatedAt
}

model Service {
  id          String        @id @default(cuid())
  projectId   String

  name        String
  type        ServiceType
  status      ServiceStatus @default(HEALTHY)
  description String?

  environment String        @default("production")
  provider    String?
  region      String?

  positionX   Float         @default(0)
  positionY   Float         @default(0)

  metadata    Json?

  project     Project       @relation(fields: [projectId], references: [id], onDelete: Cascade)

  metrics     Metric[]

  outgoingConnections Connection[] @relation("SourceService")
  incomingConnections Connection[] @relation("TargetService")

  createdAt   DateTime      @default(now())
  updatedAt   DateTime      @updatedAt

  @@index([projectId])
}

model Connection {
  id        String  @id @default(cuid())
  projectId String

  sourceId  String
  targetId  String

  type      String?

  project   Project @relation(fields: [projectId], references: [id], onDelete: Cascade)

  source    Service @relation("SourceService", fields: [sourceId], references: [id], onDelete: Cascade)
  target    Service @relation("TargetService", fields: [targetId], references: [id], onDelete: Cascade)

  createdAt DateTime @default(now())

  @@index([projectId])
  @@index([sourceId])
  @@index([targetId])
}

model Metric {
  id        String   @id @default(cuid())
  serviceId String

  cpu       Float
  memory    Float
  latency   Float
  requests  Int

  timestamp DateTime @default(now())

  service   Service  @relation(fields: [serviceId], references: [id], onDelete: Cascade)

  @@index([serviceId, timestamp])
}